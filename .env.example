# Copy to .env.local for local dev (gitignored). On Vercel set these per environment
# (Preview = staging DB, Production = prod DB). Never commit real values.

# ---- CMS (browser reads, public by design) ----
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ---- Booking engine: server side (/api/*) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Both flags must be "on" for the engine to work in that environment. Leave unset on Production until go-live.
BOOKING_ENGINE=on
VITE_BOOKING_ENGINE=on
# Random string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
# Store only its sha256 in the DB: insert into private.booking_config (id, secret_hash) values (1, '<sha256 hex>');
BOOKING_SECRET=
# Minutes a website checkout holds the room before payment (sales links set their own hours in the admin panel)
BOOKING_HOLD_MINUTES=30
# Optional: fixed base URL for payment return links (defaults to the request host)
# APP_URL=https://www.hone.example

# ---- Payment gateway ----
# mock | doku | midtrans | xendit. Leave unset: auto-picks doku when both DOKU keys below are set, else mock.
PAYMENT_PROVIDER=
# DOKU Checkout (Merchant Dashboard > API Keys & Client Id). sandbox = https://api-sandbox.doku.com, production = https://api.doku.com
DOKU_ENV=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Optional comma list restricting payment.payment_method_types (e.g. VIRTUAL_ACCOUNT_BCA,EMONEY_OVO). Empty = DOKU default.
DOKU_PAYMENT_METHODS=
# Midtrans (Dashboard > Settings > Access Keys). Notification URL is sent per transaction: <site>/api/payment/webhook
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Xendit (Dashboard > Settings > API Keys; Webhooks > Invoice paid -> <site>/api/payment/webhook, copy the verification token)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# ---- Cloudflare Turnstile (bot protection on /checkout). Leave both empty to skip it (dev only). ----
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# ---- Optional cron auth for GET /api/payment/reconcile (header Authorization: Bearer <value>). Unset = open but throttled (pg_cron calls it) ----
CRON_SECRET=

# ---- Booking emails (optional; without a key the engine only logs) ----
RESEND_API_KEY=
BOOKING_EMAIL_FROM=H One Resort <reservasi@hone.example>
BOOKING_NOTIFY_EMAIL=
# Replies to guest emails land here (hone.example has no mailboxes). A real inbox, e.g. Gmail.
BOOKING_EMAIL_REPLY_TO=
# Optional: base URL for links in emails. Default: www on production, the branch URL on previews.
PUBLIC_SITE_URL=
